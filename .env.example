# Database Connection String (SQLAlchemy format)
# Examples:
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
# MySQL:      mysql+pymysql://user:password@localhost:3306/dbname
# MSSQL:      mssql+pyodbc://user:password@localhost/dbname?driver=ODBC+Driver+17+for+SQL+Server
# SQLite:     sqlite:///local.db
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Security Guardrails
# If false, INSERT, UPDATE, DELETE, DROP, TRUNCATE, ALTER will be blocked
ALLOW_MUTATIONS=false

# Max rows to return per query to prevent LLM context overflow
MAX_ROWS=100

# Logging Configuration
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# LOG_FORMAT options: text, json
LOG_FORMAT=json
